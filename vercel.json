{
  "regions": ["sin1"],
  "services": {
    "electrobid-auction": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npx prisma db push --accept-data-loss && next build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "electrobid-auction"
      }
    }
  ]
}
